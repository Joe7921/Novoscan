# ===================================================
# Novoscan-Open-Core 环境配置
# 复制为 .env 并填入你的 API Key
# ===================================================

# ── 模型配置 ──
# 模型提供商名称（用于日志和切换，不影响实际调用）
MODEL_PROVIDER=deepseek

# 通用 OpenAI-Compatible 接口参数
# 所有国产模型（DeepSeek/MiniMax/Moonshot）均支持此协议
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=2
LLM_TIMEOUT=120

# ── 备用模型（可选，用于降级切换） ──
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://api.minimax.chat/v1
# FALLBACK_MODEL_NAME=abab6.5s-chat

# ── 检索工具 API Keys ──
# Brave Search（产业检索）
BRAVE_API_KEY=

# GitHub（开源生态检索）
GITHUB_TOKEN=

# OpenAlex（学术检索，邮箱用于提高速率限制）
OPENALEX_EMAIL=

# CrossRef（文献元数据补充）
CROSSREF_EMAIL=

# ── 服务配置 ──
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8001
LOG_LEVEL=info
